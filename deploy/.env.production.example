# ==============================================================================
# Naville SaaS - Variáveis de Ambiente de Produção (.env.production)
# Responsável: Agente DevSecOps & Infraestrutura
#
# REGRA DE SEGURANÇA CRÍTICA [12]:
# 1. NUNCA faça commit deste arquivo com valores reais no Git.
# 2. Na VPS, execute: chmod 600 /opt/naville/.env (apenas o root tem leitura)
# 3. Use geradores criptográficos (openssl rand -hex 32) para todos os segredos.
# ==============================================================================

# --- Domínios & URLs Públicas ---
APP_URL="https://naville.app"
API_URL="https://api.naville.app"
ALLOWED_ORIGINS="https://naville.app,https://barber.naville.app,https://www.naville.app"

# --- [16] Criptografia em Repouso do PocketBase ---
# Chave de 32 bytes para criptografia de dados sensíveis do SQLite em repouso
# Gerar com: openssl rand -hex 32
POCKETBASE_ENCRYPTION_KEY="CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32"

# --- [11] Autenticação & JWT ---
# Segredo para assinatura de tokens JWT de sessão
JWT_SECRET="CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32"
JWT_EXPIRATION_SECONDS="3600" # 1 hora
REFRESH_TOKEN_EXPIRATION_DAYS="7"

# --- [12] Evolution API v2 (WhatsApp) ---
EVOLUTION_API_PUBLIC_URL="https://whatsapp.naville.app"
EVOLUTION_API_GLOBAL_KEY="CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32"
EVOLUTION_WEBHOOK_URL="http://app-backend:3001/api/webhooks/evolution"

# --- [12] Invoice Ninja (Billing SaaS) ---
INVOICE_NINJA_URL="https://billing.naville.app"
INVOICE_NINJA_API_TOKEN="CHANGE_ME_SECRET_TOKEN_FROM_INVOICE_NINJA"
INVOICE_NINJA_WEBHOOK_SECRET="CHANGE_ME_WEBHOOK_SECRET_KEY"

# --- [15] Backups Externos (S3 / Cloudflare R2) ---
R2_ACCOUNT_ID="CHANGE_ME_CLOUDFLARE_ACCOUNT_ID"
R2_ACCESS_KEY_ID="CHANGE_ME_CLOUDFLARE_R2_ACCESS_KEY"
R2_SECRET_ACCESS_KEY="CHANGE_ME_CLOUDFLARE_R2_SECRET_KEY"
R2_BUCKET_NAME="naville-backups-production"
BACKUP_ENCRYPTION_PASSPHRASE="CHANGE_ME_STRONG_BACKUP_GPG_PASSPHRASE"

# --- [19] Monitoramento & Notificações de Alerta ---
ALERT_WHATSAPP_NUMBER="5511999999999"
ALERT_WEBHOOK_URL="https://discord.com/api/webhooks/CHANGE_ME/OR_SLACK"

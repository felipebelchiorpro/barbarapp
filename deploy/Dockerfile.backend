# Dockerfile para o App Backend (Node.js LTS Alpine)
FROM node:22-alpine AS builder

WORKDIR /app

COPY package*.json ./
RUN npm ci --omit=dev

COPY tsconfig.json ./
COPY src/ ./src/

# Compilação ou execução via tsx / node
FROM node:22-alpine AS runner

WORKDIR /app
ENV NODE_ENV=production

# Usuário sem privilégios de root para segurança estrita
USER node

COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package.json ./package.json
COPY --from=builder /app/tsconfig.json ./tsconfig.json
COPY --from=builder /app/src ./src

EXPOSE 3001

CMD ["npx", "tsx", "src/server/standaloneServer.ts"]
